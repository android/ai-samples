# JetPacker demo profile for Play Console internal testing.
# Copy this file to profiles/<name>.conf and customize:
#   build_play_bundle.sh --profile <name> --version-code N
#
# Notice: Never commit real signing passwords or keystores to source control.

PLAY_CONSOLE=https://play.google.com/console
DEVELOPER_ID=1234567890123456789
APPLICATION_ID=com.example.jetpacker
KEYSTORE=~/keys/jetpacker-upload.jks
# UNIVERSAL_APK=~/jetpacker-play.apk # Requires BUNDLETOOL_JAR or bundletool on PATH
